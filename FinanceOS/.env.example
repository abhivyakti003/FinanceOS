# Easiest: run `python scripts/configure.py` (or setup.bat) and it writes this file for you.
# Never share or commit .env.

# ---- Environment ----
# development on your laptop, production on a server (production refuses unsafe settings)
APP_ENV=development
LOG_LEVEL=INFO
SUPPORT_EMAIL=

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Database ----
# Leave empty to use financeos.db in the project folder (SQLite).
# For PostgreSQL (pip install -r requirements-postgres.txt first):
# DATABASE_URL=postgresql://financeos:yourpassword@localhost:5432/financeos
DATABASE_URL=

# ---- Email: option 1, Gmail ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=FinanceOS <youraddress@gmail.com>

# ---- Email: option 2, Brevo (works on networks that block email ports) ----
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# SMTP_FROM=FinanceOS <your-verified-sender@gmail.com>

# true = print codes in the terminal instead of emailing. Local testing only.
EMAIL_DEV_MODE=false
EMAIL_CHECK_DELIVERABILITY=true
OTP_EXPIRY_MINUTES=10

# ---- Admin and sessions ----
# Emails allowed to open the Admin page, comma-separated.
ADMIN_EMAILS=
SESSION_TIMEOUT_MINUTES=30
BACKUP_KEEP=14

# ---- Account Aggregator ----
AA_PROVIDER=mock
SETU_AA_BASE_URL=
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# ---- Daily jobs (Docker worker) ----
DAILY_JOBS_HOUR=8

# ---- Docker / server deployment ----
POSTGRES_PASSWORD=
DOMAIN=

# ---- Legal pages (filled into docs/legal/*.md) ----
LEGAL_OPERATOR_NAME=
LEGAL_GRIEVANCE_OFFICER=
LEGAL_DATA_LOCATION=India
LEGAL_JURISDICTION=
LEGAL_LAST_UPDATED=
