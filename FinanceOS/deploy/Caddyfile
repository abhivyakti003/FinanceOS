# HTTPS reverse proxy. Caddy gets and renews a free Let's Encrypt certificate
# automatically for $DOMAIN (point the domain's DNS A record at this server first).
{$DOMAIN} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy app:8501
}
